# OAuth client secrets
oauth-clients/*
!oauth-clients/.gitkeep

# Local playlist tracklists & playlists.json
playlists/*
!playlists/.gitkeep
data
!data/.gitkeep

# Local operation logs
logs/*
!logs/.gitkeep

# General secret patterns and tokens
*secret*.json
*client*.json
token*.json
*.token

# Python cache & temporary files
__pycache__/
*.py[cod]
*.bak
*.tmp

# Playlist settings & dev overrides
playlist-settings.toml
DEV-*.toml
DEV-settings.toml
DEV-playlist-settings.toml

# Playlist downloads
playlist-downloads/*
!playlist-downloads/.gitkeep

# yt-dlp and ffmpeg binaries (if downloaded locally)
yt-dlp.exe
yt-dlp
ffmpeg.exe
ffmpeg
ffprobe.exe
# Cookies and exported URLs
*cookies.txt
*_urls.txt

