# OAuth client secrets
oauth-clients/*
!oauth-clients/.gitkeep

# Local playlist data
data/playlists.json
!data/.gitkeep

# Local playlist tracklists
playlists/*
!playlists/.gitkeep

# Local operation logs
logs/*
!logs/.gitkeep

# General secret patterns and tokens
*secret*.json
*client*.json
token*.json
*.token

# Python cache & temporary files
__pycache__/
*.py[cod]
*.bak
*.tmp

# Playlist downloads
playlist-downloads/*
!playlist-downloads/.gitkeep

# yt-dlp and ffmpeg binaries (if downloaded locally)
yt-dlp.exe
yt-dlp
ffmpeg.exe
ffmpeg
ffprobe.exe
ffprobe

